<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mensagem do Dia - Ron Swanson</title>
  <!-- Bootstrap 5 CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light d-flex align-items-center min-vh-100">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-8 col-lg-6 text-center">
        
        <div class="card shadow-lg border-0 rounded-4 p-4">
          <div class="card-body">
            <h1 class="card-title h3 mb-4 text-primary font-weight-bold">
              💡 Mensagem do Dia
            </h1>

            <% if (quotePt) { %>
              <blockquote class="blockquote my-4">
                <p class="fs-4 fw-semibold text-dark">"<%= quotePt %>"</p>
                <footer class="blockquote-footer mt-3">
                  <span class="d-block text-secondary mb-1">— <strong>Ron Swanson</strong></span>
                  <small class="text-muted">Original em inglês: <em>"<%= quoteEn %>"</em></small>
                </footer>
              </blockquote>
            <% } else { %>
              <div class="alert alert-danger" role="alert">
                <%= error %>
              </div>
            <% } %>

            <div class="mt-4">
              <a href="/" class="btn btn-primary btn-lg rounded-pill px-4 shadow-sm">
                🔄 Nova Mensagem
              </a>
            </div>
          </div>
        </div>

        <p class="text-muted mt-3 small">
          Aplicação desenvolvida com Node.js, Express, EJS e Bootstrap.
        </p>

      </div>
    </div>
  </div>
</body>
</html>