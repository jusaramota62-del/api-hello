<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>API Hello Project - NASA Astros</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    .carousel-img {
      height: 480px;
      object-fit: cover;
    }
  </style>
</head>
<body class="bg-dark text-light min-vh-100 d-flex flex-column">

  <!-- Menu de Navegação Superior (Navbar) -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-secondary shadow-sm mb-4">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">🚀 API Hello Project</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto align-items-center">
          <li class="nav-item">
            <a class="nav-link fw-semibold" href="/">💡 Mensagem do Dia (Aula 17)</a>
          </li>
          <li class="nav-item">
            <a class="nav-link active fw-bold text-warning" href="/nasa">🌌 NASA Astros (Aula 18)</a>
          </li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle fw-semibold" href="#" id="apiDropdown" role="button" data-bs-toggle="dropdown">
              🔌 Endpoints REST (v1 / v2)
            </a>
            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark">
              <li><h6 class="dropdown-header">API v1</h6></li>
              <li><a class="dropdown-item" href="/v1/hi" target="_blank">GET /v1/hi</a></li>
              <li><a class="dropdown-item" href="/v1/hi/user/Jusara" target="_blank">GET /v1/hi/user/:name</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><h6 class="dropdown-header">API v2 (Multilingue)</h6></li>
              <li><a class="dropdown-item" href="/v2/hi/pt-br" target="_blank">GET /v2/hi/pt-br</a></li>
              <li><a class="dropdown-item" href="/v2/hi/es" target="_blank">GET /v2/hi/es</a></li>
              <li><a class="dropdown-item" href="/v2/hi/en" target="_blank">GET /v2/hi/en</a></li>
              <li><a class="dropdown-item" href="/v2/hi/user/pt-br/Jusara" target="_blank">GET /v2/hi/user/pt-br/:name</a></li>
            </ul>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Conteúdo Principal -->
  <div class="container my-auto py-3">
    <div class="row justify-content-center">
      <div class="col-lg-10 text-center">

        <h1 class="display-5 fw-bold mb-3 text-warning">🌌 Galeria da NASA - Carrossel de Astros</h1>
        <p class="text-secondary mb-4">Busque imagens sem copyright direto do acervo da NASA.</p>

        <!-- Formulário de Pesquisa -->
        <form action="/nasa" method="GET" class="row g-2 justify-content-center mb-4">
          <div class="col-md-6 col-8">
            <input 
              type="text" 
              name="astro" 
              class="form-control form-control-lg bg-secondary text-white border-0" 
              placeholder="Digite um astro (ex: Moon, Mars, Sun, Saturn, Galaxy)..." 
              value="<%= astro %>"
              required
            >
          </div>
          <div class="col-md-2 col-4">
            <button type="submit" class="btn btn-warning btn-lg w-100 fw-bold">Buscar 🔍</button>
          </div>
        </form>

        <% if (error) { %>
          <div class="alert alert-danger shadow-sm"><%= error %></div>
        <% } %>

        <!-- Carrossel Bootstrap -->
        <% if (images && images.length > 0) { %>
          <div class="card bg-secondary text-white border-0 shadow-lg rounded-4 overflow-hidden mb-4">
            <div class="card-body p-0">
              <div id="nasaCarousel" class="carousel slide" data-bs-ride="carousel">
                
                <div class="carousel-indicators">
                  <% images.forEach((img, idx) => { %>
                    <button 
                      type="button" 
                      data-bs-target="#nasaCarousel" 
                      data-bs-slide-to="<%= idx %>" 
                      class="<%= idx === 0 ? 'active' : '' %>" 
                      aria-current="<%= idx === 0 ? 'true' : 'false' %>">
                    </button>
                  <% }); %>
                </div>

                <div class="carousel-inner">
                  <% images.forEach((img, idx) => { %>
                    <div class="carousel-item <%= idx === 0 ? 'active' : '' %>">
                      <img src="<%= img.url %>" class="d-block w-100 carousel-img" alt="<%= img.title %>">
                      <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-75 rounded-3 p-3">
                        <h5 class="fw-bold text-warning"><%= img.title %></h5>
                        <p class="small mb-1 text-truncate"><%= img.explanation %></p>
                        <span class="badge bg-success">Domínio Público</span>
                      </div>
                    </div>
                  <% }); %>
                </div>

                <button class="carousel-control-prev" type="button" data-bs-target="#nasaCarousel" data-bs-slide="prev">
                  <span class="carousel-control-prev-icon"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#nasaCarousel" data-bs-slide="next">
                  <span class="carousel-control-next-icon"></span>
                </button>

              </div>
            </div>
          </div>
        <% } else if (astro) { %>
          <div class="alert alert-info shadow-sm mb-4">
            Nenhuma imagem encontrada para "<strong><%= astro %></strong>". Tente termos em inglês como <em>Moon, Mars, Sun, Saturn, Nebula, Galaxy</em>.
          </div>
        <% } %>

      </div>
    </div>
  </div>

  <footer class="text-center text-secondary py-3 mt-auto small">
    Programação Web 1 • Exercício Aula 18 (NASA Open APIs)
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>