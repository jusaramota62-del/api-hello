<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NASA - Explorador de Astros</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    .carousel-img {
      height: 480px;
      object-fit: cover;
    }
  </style>
</head>
<body class="bg-dark text-light min-vh-100 d-flex flex-column">

  <nav class="navbar navbar-expand-lg navbar-dark bg-secondary shadow-sm mb-4">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">🚀 API Hello Project</a>
      <div class="navbar-nav">
        <a class="nav-link" href="/">Mensagem do Dia</a>
        <a class="nav-link active fw-bold" href="/nasa">NASA Astros (Aula 18)</a>
      </div>
    </div>
  </nav>

  <div class="container my-auto py-4">
    <div class="row justify-content-center">
      <div class="col-lg-10 text-center">

        <h1 class="display-5 fw-bold mb-3 text-warning">🌌 Galeria da NASA - Carrossel de Astros</h1>
        <p class="text-secondary mb-4">Busque imagens sem copyright direto do banco de dados de astronomia da NASA.</p>

        <!-- Formulario de Pesquisa -->
        <form action="/nasa" method="GET" class="row g-2 justify-content-center mb-5">
          <div class="col-md-6 col-8">
            <input 
              type="text" 
              name="astro" 
              class="form-control form-control-lg bg-secondary text-white border-0" 
              placeholder="Digite um astro (ex: Mars, Moon, Sun, Saturn, Galaxy)..." 
              value="<%= astro %>"
              required
            >
          </div>
          <div class="col-md-2 col-4">
            <button type="submit" class="btn btn-warning btn-lg w-100 fw-bold">Buscar 🔍</button>
          </div>
        </form>

        <% if (error) { %>
          <div class="alert alert-danger shadow-sm"><%= error %></div>
        <% } %>

        <!-- Carrossel Bootstrap -->
        <% if (images && images.length > 0) { %>
          <div class="card bg-secondary text-white border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="card-body p-0">
              <div id="nasaCarousel" class="carousel slide" data-bs-ride="carousel">
                
                <!-- Indicadores -->
                <div class="carousel-indicators">
                  <% images.forEach((img, idx) => { %>
                    <button 
                      type="button" 
                      data-bs-target="#nasaCarousel" 
                      data-bs-slide-to="<%= idx %>" 
                      class="<%= idx === 0 ? 'active' : '' %>" 
                      aria-current="<%= idx === 0 ? 'true' : 'false' %>" 
                      aria-label="Slide <%= idx + 1 %>">
                    </button>
                  <% }); %>
                </div>

                <!-- Slides -->
                <div class="carousel-inner">
                  <% images.forEach((img, idx) => { %>
                    <div class="carousel-item <%= idx === 0 ? 'active' : '' %>">
                      <img src="<%= img.url %>" class="d-block w-100 carousel-img" alt="<%= img.title %>">
                      <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-75 rounded-3 p-3">
                        <h5 class="fw-bold text-warning"><%= img.title %></h5>
                        <p class="small mb-1 text-truncate"><%= img.explanation %></p>
                        <span class="badge bg-success">Domínio Público (Sem Copyright)</span>
                      </div>
                    </div>
                  <% }); %>
                </div>

                <!-- Botoes de Navegacao -->
                <button class="carousel-control-prev" type="button" data-bs-target="#nasaCarousel" data-bs-slide="prev">
                  <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                  <span class="visually-hidden">Anterior</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#nasaCarousel" data-bs-slide="next">
                  <span class="carousel-control-next-icon" aria-hidden="true"></span>
                  <span class="visually-hidden">Próximo</span>
                </button>

              </div>
            </div>
          </div>
          <p class="text-secondary mt-3 small">Encontradas <%= images.length %> imagem(ns) no acervo da NASA para "<%= astro %>".</p>
        <% } else if (astro) { %>
          <div class="alert alert-info shadow-sm">
            Nenhuma imagem sem copyright foi encontrada para "<strong><%= astro %></strong>". Tente buscar em inglês por palavras como <em>Mars, Moon, Sun, Saturn, Nebula, Galaxy</em>.
          </div>
        <% } %>

      </div>
    </div>
  </div>

  <footer class="text-center text-secondary py-3 mt-auto">
    <small>Exercício final da Aula 18 • NASA Open APIs</small>
  </footer>

  <!-- JS do Bootstrap para animar o Carrossel -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>